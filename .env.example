# ====== 运行环境 ======
# development: 本地开发模式
# production:  生产环境模式
NODE_ENV=production

# ====== 后端端口 ======
# 后端 Express 服务监听的端口号
PORT=3000

# ====== AI API 配置 ======
# 兼容 OpenAI 接口格式，支持 DeepSeek、OpenAI、通义千问等服务商
# 以下三个字段必须同时填写才会启用真实 AI 生成
# 全部留空则自动使用 Mock 模式（返回示例内容，方便测试）
# ---
# API 地址（结尾不要带 /chat/completions，系统会自动拼接）
AI_API_BASE_URL=https://api.example.com/v1
# API 密钥
AI_API_KEY=your_api_key_here
# 模型名称，例如：
#   DeepSeek: deepseek-chat / deepseek-v4-flash
#   OpenAI:   gpt-4o / gpt-3.5-turbo
#   通义千问: qwen-plus / qwen-max
AI_MODEL=your_model_name_here

# ====== 搜索配置 ======
# 搜索服务提供商标识（当前版本仅支持 basic）
SEARCH_PROVIDER=basic

# ====== 限流配置 ======
# 控制同一 IP 的生成频率，防止 API 被滥用或费用失控
# ---
# 限流时间窗口（分钟），在此窗口内最多允许 RATE_LIMIT_MAX_REQUESTS 次
RATE_LIMIT_WINDOW_MINUTES=10
# 窗口内最大请求次数
RATE_LIMIT_MAX_REQUESTS=3
# 每日最大请求次数（按自然日计算，北京时间）
RATE_LIMIT_DAILY_MAX=20
# 提示：本地开发测试时可将这三个值设大或清空（清空后使用代码默认值 10/3/20）
